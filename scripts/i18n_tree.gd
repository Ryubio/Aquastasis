	"tree.economy_bonds.name": {"tr": "Mavi Tahviller", "en": "Blue Bonds", "ru": "Голубые облигации"},
	"tree.economy_bonds.desc": {"tr": "Yatırımcılar restorasyonu fonlar: yılda +15 bütçe ve mercanlar %15 daha hızlı iyileşir.", "en": "Investors fund restoration: +15 budget per year, and coral regrows 15% faster.", "ru": "Инвестиции в экопроекты: +15 бюджета ежегодно, кораллы растут на 15% быстрее."},
	"tree.economy_bonds.fact": {"tr": "2018'de Seyşeller, deniz koruma ve sürdürülebilir balıkçılığı finanse etmek için dünyanın ilk mavi tahvilini ihraç etti.", "en": "In 2018 the Seychelles issued the world's first sovereign blue bond to fund marine protection and sustainable fisheries.", "ru": "В 2018 г. Сейшелы выпустили первые в мире суверенные голубые облигации для защиты вод."},
	"tree.economy_carbon.name": {"tr": "Karbon Fiyatlandırması", "en": "Carbon Pricing", "ru": "Углеродное ценообразование"},
	"tree.economy_carbon.desc": {"tr": "Emisyonlara vergi koyar: ısınma %20 yavaşlar ve karbon geliri yılda +10 bütçe sağlar.", "en": "Puts a price on emissions: warming slows by 20%, and carbon revenue adds +10 budget per year.", "ru": "Плата за выбросы: потепление замедляется на 20%, доходы от квот дают +10 бюджета в год."},
	"tree.economy_carbon.fact": {"tr": "2024'ten bu yana AB Emisyon Ticaret Sistemi, AB limanlarına yanaşan büyük gemilerin CO2 salımlarını da vergilendiriyor.", "en": "Since 2024 the EU Emissions Trading System also prices CO2 from large ships calling at EU ports.", "ru": "С 2024 г. система торговли квотами ЕС взимает плату за выбросы CO2 с крупных морских судов."},

	# --- Crisis evolutions (resistances) ---
	"evo.source_surge.name": {"tr": "Havza İçi Kirlilik Patlaması", "en": "Upstream Surge", "ru": "Загрязнение верховий"},
	"evo.source_surge.desc": {"tr": "Sadece deniz temizliği kirleticilerin nehirlerin yukarısına atık dökmesine yol açtı. Kaynak girdisi +%40, temizlik %20 zayıf.", "en": "Cleanups alone taught polluters to dump further upstream. Source inflow +40%, cleanups 20% weaker.", "ru": "Сбросы сместились вверх по рекам: приток загрязнения +40%, очистка слабее на 20%."},
	"evo.source_surge.news": {"tr": "Kriz evrildi: atıklar nehirlerin yukarısına kaydı, nehirler denize plastik taşıyor", "en": "Crisis evolves: dumping shifts upstream as rivers flood the sea with plastic", "ru": "Кризис адаптировался: сбросы ушли вверх по руслам рек, отравляя море пластиком"},
	"evo.source_surge.cured": {"tr": "Havza kirlilik patlaması durduruldu: yeni kurallar atıkları kaynağında kesti", "en": "Upstream surge broken: new rules choke pollution at the source", "ru": "Прорыв в верховьях ликвидирован: новые законы перекрыли стоки отходов"},
	"evo.illegal_fishing.name": {"tr": "Kaçak Av Filoları", "en": "Poacher Fleets", "ru": "Браконьерские флотилии"},
	"evo.illegal_fishing.desc": {"tr": "Balıkla dolan koruma alanları kaçak avcıları çekti. Av baskısı +%50, devriyeler %20 zayıf.", "en": "Fish-rich protected waters lure poachers. Fishing pressure +50%, patrols 20% weaker.", "ru": "Рыбные запасы манят браконьеров: нагрузка вылова +50%, патрули слабее на 20%."},
	"evo.illegal_fishing.news": {"tr": "Kriz evrildi: kaçak avcı filoları geceleri koruma altındaki suları yağmalıyor", "en": "Crisis evolves: poacher fleets raid protected waters by night", "ru": "Кризис адаптировался: браконьеры опустошают заповедные акватории под покровом ночи"},
	"evo.illegal_fishing.cured": {"tr": "Kaçak av filoları tespit edildi ve havza genelinde bağlandı", "en": "Poacher fleets tracked down and grounded across the basin", "ru": "Браконьерские суда выслежены со спутников и арестованы по всему морю"},
	"evo.disinformation.name": {"tr": "Dezenformasyon Dalgası", "en": "Disinformation Wave", "ru": "Волна дезинформации"},
	"evo.disinformation.desc": {"tr": "Sürekli kampanyalar bıkkınlık ve yalan haber yarattı. Farkındalık %50 daha hızlı siliniyor, siyasi destek geliri -%20.", "en": "Endless campaigns breed fatigue and fake news. Awareness fades 50% faster, political support income -20%.", "ru": "Усталость от агитации породила фейки: осведомленность падает на 50% быстрее, доход поддержки -20%."},
	"evo.disinformation.news": {"tr": "Kriz evrildi: 'deniz gayet iyi' yalan haberleri sosyal medyayı kapladı", "en": "Crisis evolves: fake 'the sea is fine' stories flood social media", "ru": "Кризис адаптировался: соцсети наводнили фейки о том, что с морем все в порядке"},
	"evo.disinformation.cured": {"tr": "Gerçekler kazandı: deniz bilimine olan toplumsal güven tazelendi", "en": "Fact-checkers turn the tide: trust in ocean science recovers", "ru": "Правда восторжествовала: доверие к морской науке полностью восстановлено"},
	"evo.lobby_backlash.name": {"tr": "Lobi Direnci", "en": "Lobby Backlash", "ru": "Лоббистский саботаж"},
	"evo.lobby_backlash.desc": {"tr": "Sanayi her yeni kurala karşı dava açıyor. Politikalar %25 daha pahalı, siyasi destek geliri -%20.", "en": "Industry fights every new rule. Policies cost 25% more, political support income -20%.", "ru": "Бизнес блокирует реформы: политики стоят на 25% дороже, доход поддержки -20%."},
	"evo.lobby_backlash.news": {"tr": "Kriz evrildi: sanayi lobileri başkentlerde deniz kurallarını tıkıyor", "en": "Crisis evolves: industry lobbies stall marine rules in every capital", "ru": "Кризис адаптировался: промышленное лобби парализует эко-законы в парламентах"},
	"evo.lobby_backlash.cured": {"tr": "Lobi direnci kırıldı: sanayi mavi ekonomi ortaklığına katılmak zorunda kaldı", "en": "Lobby backlash fades as industry joins the blue economy", "ru": "Саботаж преодолен: промышленность перешла на стандарты синей экономики"},
	"evo.marine_heatwave.name": {"tr": "Kalıcı Deniz Sıcak Dalgaları", "en": "Marine Heatwaves", "ru": "Морские волны тепла"},
	"evo.marine_heatwave.desc": {"tr": "Aşırı ısınan sular deniz tabanını pişiriyor. Mercan ısı hasarı +%50, ısı stresi +%30.", "en": "Warming water bakes the seabed. Coral heat damage +50%, heat stress +30%.", "ru": "Кипящая вода выжигает дно: тепловой урон кораллам +50%, общий стресс +30%."},
	"evo.marine_heatwave.news": {"tr": "Kriz evrildi: peş peşe gelen denizel sıcak hava dalgaları havzayı kavuruyor", "en": "Crisis evolves: back-to-back marine heatwaves scorch the basin", "ru": "Кризис адаптировался: череда волн экстремального тепла выжигает биоту моря"},
	"evo.marine_heatwave.cured": {"tr": "Sıcağa dayanıklı resifler ve düşen emisyonlar sıcak dalgalarının etkisini kırdı", "en": "Heat-resilient reefs and lower emissions blunt the heatwaves", "ru": "Устойчивые рифы и сдерживание потепления нейтрализовали угрозу волн тепла"},
	"evo.invasive_species.name": {"tr": "İstilacı Tür İstilası", "en": "Invasive Species", "ru": "Нашествие инвазивных видов"},
	"evo.invasive_species.desc": {"tr": "Yabancı türler Süveyş ve balast sularıyla akın ediyor. Kriz %30 daha sık yayılıyor, balıklar %15 daha yavaş çoğalıyor.", "en": "Alien species arrive through Suez and in ballast water. The crisis spreads 30% more often, fish regrow 15% slower.", "ru": "Чужеродные виды проникают через Суэц и балласт: кризис распространяется на 30% чаще, рыба медленнее на 15%."},
	"evo.invasive_species.news": {"tr": "Kriz evrildi: istilacı türler Süveyş Kanalı ve balast tanklarıyla havzayı sarıyor", "en": "Crisis evolves: invasive species pour in through Suez and ballast tanks", "ru": "Кризис адаптировался: полчища чужеродных видов проникают через Суэц и балластные воды"},
	"evo.invasive_species.cured": {"tr": "İstilacılar kontrol altına alındı: yerli türler sularını geri kazandı", "en": "Invaders contained: native species reclaim their waters", "ru": "Инвазивные виды изолированы: коренная фауна восстановила популяцию"},
}
